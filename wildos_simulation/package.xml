<?xml version="1.0"?>
<package format="3">
  <name>wildos_simulation</name>
  <version>0.1.0</version>
  <description>Minimal Gazebo Harmonic sensor rig for WildOS development.</description>

  <maintainer email="admin1@example.com">WildOS Simulation</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>message_filters</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>graphnav_mapper</exec_depend>
  <exec_depend>graphnav_planner</exec_depend>
  <exec_depend>visual_navigation</exec_depend>
  <exec_depend>pose_graph_msgs</exec_depend>
  <exec_depend>elevation_mapping_cupy</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
