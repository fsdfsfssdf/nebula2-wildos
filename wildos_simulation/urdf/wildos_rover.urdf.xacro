<?xml version="1.0"?>
<robot name="wildos_rover" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <material name="body_blue">
    <color rgba="0.10 0.35 0.85 1.0"/>
  </material>
  <material name="wheel_dark">
    <color rgba="0.04 0.04 0.04 1.0"/>
  </material>
  <material name="sensor_gray">
    <color rgba="0.25 0.25 0.25 1.0"/>
  </material>

  <link name="base_link">
    <inertial>
      <!-- Ballast low in the chassis: the stand-in rover is 22 kg on 0.78 m
           wheels and rolled over on the bank in front of the house at
           0.8 m/s with the centre of mass at axle height. -->
      <origin xyz="0 0 -0.18" rpy="0 0 0"/>
      <mass value="18.0"/>
      <inertia ixx="0.50" ixy="0" ixz="0" iyy="0.82" iyz="0" izz="1.10"/>
    </inertial>
    <collision>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <geometry>
        <box size="0.90 0.68 0.26"/>
      </geometry>
    </collision>
    <visual>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <geometry>
        <box size="0.90 0.68 0.26"/>
      </geometry>
      <material name="body_blue"/>
    </visual>
  </link>

  <link name="left_wheel_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.5"/>
      <inertia ixx="0.012" ixy="0" ixz="0" iyy="0.024" iyz="0" izz="0.012"/>
    </inertial>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.18" length="0.10"/>
      </geometry>
    </collision>
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.18" length="0.10"/>
      </geometry>
      <material name="wheel_dark"/>
    </visual>
  </link>

  <link name="right_wheel_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.5"/>
      <inertia ixx="0.012" ixy="0" ixz="0" iyy="0.024" iyz="0" izz="0.012"/>
    </inertial>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.18" length="0.10"/>
      </geometry>
    </collision>
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.18" length="0.10"/>
      </geometry>
      <material name="wheel_dark"/>
    </visual>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel_link"/>
    <origin xyz="0 0.55 -0.14" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="100" velocity="20"/>
  </joint>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel_link"/>
    <origin xyz="0 -0.55 -0.14" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="100" velocity="20"/>
  </joint>

  <link name="front_caster_link">
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    <collision>
      <geometry><sphere radius="0.10"/></geometry>
    </collision>
    <visual>
      <geometry><sphere radius="0.10"/></geometry>
      <material name="wheel_dark"/>
    </visual>
  </link>

  <link name="rear_caster_link">
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    <collision>
      <geometry><sphere radius="0.10"/></geometry>
    </collision>
    <visual>
      <geometry><sphere radius="0.10"/></geometry>
      <material name="wheel_dark"/>
    </visual>
  </link>

  <joint name="front_caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_caster_link"/>
    <origin xyz="0.32 0 -0.22" rpy="0 0 0"/>
  </joint>
  <joint name="rear_caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rear_caster_link"/>
    <origin xyz="-0.32 0 -0.22" rpy="0 0 0"/>
  </joint>

  <link name="front_camera_link">
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <geometry><box size="0.10 0.12 0.06"/></geometry>
      <material name="sensor_gray"/>
    </visual>
  </link>
  <joint name="front_camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_camera_link"/>
    <origin xyz="0.47 0 0.20" rpy="0 0 0"/>
  </joint>

  <link name="left_camera_link">
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <geometry><box size="0.10 0.12 0.06"/></geometry>
      <material name="sensor_gray"/>
    </visual>
  </link>
  <joint name="left_camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="left_camera_link"/>
    <origin xyz="0.12 0.36 0.20" rpy="0 0 1.5708"/>
  </joint>

  <link name="right_camera_link">
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <geometry><box size="0.10 0.12 0.06"/></geometry>
      <material name="sensor_gray"/>
    </visual>
  </link>
  <joint name="right_camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="right_camera_link"/>
    <origin xyz="0.12 -0.36 0.20" rpy="0 0 -1.5708"/>
  </joint>

  <link name="lidar_link">
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.002"/>
    </inertial>
    <visual>
      <geometry><cylinder radius="0.07" length="0.10"/></geometry>
      <material name="sensor_gray"/>
    </visual>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 0.25" rpy="0 0 0"/>
  </joint>

  <link name="imu_link">
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.00005" ixy="0" ixz="0" iyy="0.00005" iyz="0" izz="0.00005"/>
    </inertial>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.02" rpy="0 0 0"/>
  </joint>

  <!-- Gazebo publishes sensor and odometry headers using scoped names. Keep
       matching TF aliases so downstream ROS nodes can look them up directly. -->
  <link name="wildos_rover/base_link"/>
  <joint name="gazebo_base_frame_joint" type="fixed">
    <parent link="base_link"/>
    <child link="wildos_rover/base_link"/>
  </joint>

  <link name="wildos_rover/base_link/front_camera"/>
  <joint name="gazebo_front_camera_frame_joint" type="fixed">
    <parent link="front_camera_link"/>
    <child link="wildos_rover/base_link/front_camera"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>

  <link name="wildos_rover/base_link/left_camera"/>
  <joint name="gazebo_left_camera_frame_joint" type="fixed">
    <parent link="left_camera_link"/>
    <child link="wildos_rover/base_link/left_camera"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>

  <link name="wildos_rover/base_link/right_camera"/>
  <joint name="gazebo_right_camera_frame_joint" type="fixed">
    <parent link="right_camera_link"/>
    <child link="wildos_rover/base_link/right_camera"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>

  <link name="wildos_rover/base_link/lidar"/>
  <joint name="gazebo_lidar_frame_joint" type="fixed">
    <parent link="lidar_link"/>
    <child link="wildos_rover/base_link/lidar"/>
  </joint>

  <link name="wildos_rover/base_link/imu"/>
  <joint name="gazebo_imu_frame_joint" type="fixed">
    <parent link="imu_link"/>
    <child link="wildos_rover/base_link/imu"/>
  </joint>

  <gazebo reference="left_wheel_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>
  <gazebo reference="right_wheel_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>

  <gazebo reference="front_camera_link">
    <sensor name="front_camera" type="camera">
      <topic>/spot1/realsense/front/color/camera</topic>
      <always_on>true</always_on>
      <update_rate>20</update_rate>
      <visualize>false</visualize>
      <camera name="front_camera">
        <horizontal_fov>1.518</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip><near>0.10</near><far>100.0</far></clip>
      </camera>
    </sensor>
  </gazebo>

  <gazebo reference="left_camera_link">
    <sensor name="left_camera" type="camera">
      <topic>/spot1/realsense/left/color/camera</topic>
      <always_on>true</always_on>
      <update_rate>20</update_rate>
      <visualize>false</visualize>
      <camera name="left_camera">
        <horizontal_fov>1.518</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip><near>0.10</near><far>100.0</far></clip>
      </camera>
    </sensor>
  </gazebo>

  <gazebo reference="right_camera_link">
    <sensor name="right_camera" type="camera">
      <topic>/spot1/realsense/right/color/camera</topic>
      <always_on>true</always_on>
      <update_rate>20</update_rate>
      <visualize>false</visualize>
      <camera name="right_camera">
        <horizontal_fov>1.518</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip><near>0.10</near><far>100.0</far></clip>
      </camera>
    </sensor>
  </gazebo>

  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <topic>/spot1/lidar</topic>
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <visualize>false</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
          <vertical>
            <samples>16</samples>
            <resolution>1</resolution>
            <min_angle>-0.45</min_angle>
            <max_angle>0.45</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.30</min>
          <max>30.0</max>
          <resolution>0.01</resolution>
        </range>
      </lidar>
    </sensor>
  </gazebo>

  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <topic>/spot1/imu</topic>
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <visualize>false</visualize>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>1.10</wheel_separation>
      <wheel_radius>0.18</wheel_radius>
      <odom_publish_frequency>20</odom_publish_frequency>
      <max_linear_velocity>1.2</max_linear_velocity>
      <!-- Stand-in chassis on 10-15 deg terrain: the diff-drive default of
           5 Nm is right at the stall point (22 kg, wheel r=0.18 m), which
           made Nav2 command motion that never happened. -->
      <max_wheel_torque>25</max_wheel_torque>
      <max_wheel_acceleration>4</max_wheel_acceleration>
      <max_angular_velocity>1.5</max_angular_velocity>
      <min_linear_velocity>-0.5</min_linear_velocity>
      <min_angular_velocity>-1.5</min_angular_velocity>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher"/>
  </gazebo>
</robot>
