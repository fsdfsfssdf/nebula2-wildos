      <origin rpy="0 0 0" xyz="-1.1929E-05 -0.02475 1.4454E-05"/>
      <mass value="1.7547"/>
      <inertia ixx="0.0041497" ixy="-3.5434E-07" ixz="1.672E-06" iyy="0.0078035" iyz="7.1022E-08" izz="0.0041483"/>
    </inertial>
    <visual name="FR_foot_visual">
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find wildos_simulation)/urdf/d1h/meshes/r_foot.STL"/>
      </geometry>
      <material name="d1h_fr_wheel">
        <color rgba="1 1 1 1"/>
      </material>
    </visual>
    <collision name="FR_foot_collision">
      <origin rpy="1.55 0 0" xyz="0 -0.025 0"/>
      <geometry>
        <cylinder length="0.04" radius="0.087"/>
      </geometry>
    </collision>
  </link>
  <!-- R wheel joint -->
  <joint name="FR_foot_joint" type="revolute">
    <origin rpy="0 0 0" xyz="0.18376 -0.0305 -0.16951"/>
    <parent link="FR_calf"/>
    <child link="FR_foot"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.005" friction="0.02"/>
    <limit effort="40" lower="-31415926" upper="31415926" velocity="30"/>
  </joint>
  <gazebo reference="front_support_link">
    <mu1>0.01</mu1>
    <mu2>0.01</mu2>
  </gazebo>
  <gazebo reference="rear_support_link">
    <mu1>0.01</mu1>
    <mu2>0.01</mu2>
  </gazebo>
  <gazebo reference="nav_skid_link">
    <mu1>0.02</mu1>
    <mu2>0.02</mu2>
  </gazebo>
  <gazebo reference="FL_foot">
    <mu1>0.9</mu1>
    <mu2>0.9</mu2>
  </gazebo>
  <gazebo reference="FR_foot">
    <mu1>0.9</mu1>
    <mu2>0.9</mu2>
  </gazebo>

  <gazebo reference="front_camera_link">
    <sensor name="front_camera" type="camera">
      <topic>/spot1/realsense/front/color/camera</topic>
      <always_on>true</always_on>
      <update_rate>20</update_rate>
      <visualize>false</visualize>
      <camera name="front_camera">
        <horizontal_fov>1.518</horizontal_fov>
        <image><width>640</width><height>480</height><format>R8G8B8</format></image>
        <clip><near>0.10</near><far>100.0</far></clip>
      </camera>
    </sensor>
  </gazebo>
  <gazebo reference="left_camera_link">
    <sensor name="left_camera" type="camera">
      <topic>/spot1/realsense/left/color/camera</topic>
      <always_on>true</always_on>
      <update_rate>20</update_rate>
      <visualize>false</visualize>
      <camera name="left_camera">
        <horizontal_fov>1.518</horizontal_fov>
        <image><width>640</width><height>480</height><format>R8G8B8</format></image>
        <clip><near>0.10</near><far>100.0</far></clip>
      </camera>
    </sensor>
  </gazebo>
  <gazebo reference="right_camera_link">
    <sensor name="right_camera" type="camera">
      <topic>/spot1/realsense/right/color/camera</topic>
      <always_on>true</always_on>
      <update_rate>20</update_rate>
      <visualize>false</visualize>
      <camera name="right_camera">
        <horizontal_fov>1.518</horizontal_fov>
        <image><width>640</width><height>480</height><format>R8G8B8</format></image>
        <clip><near>0.10</near><far>100.0</far></clip>
      </camera>
    </sensor>
  </gazebo>

  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <topic>/spot1/lidar</topic>
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <visualize>false</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
          <vertical>
            <samples>128</samples>
            <resolution>1</resolution>
            <min_angle>-0.785398</min_angle>
            <max_angle>0.785398</max_angle>
          </vertical>
        </scan>
        <range><min>0.30</min><max>30.0</max><resolution>0.01</resolution></range>
      </lidar>
    </sensor>
  </gazebo>

  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <topic>/spot1/imu</topic>
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <visualize>false</visualize>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>FL_foot_joint</left_joint>
      <right_joint>FR_foot_joint</right_joint>
      <wheel_separation>0.4407</wheel_separation>
      <wheel_radius>0.087</wheel_radius>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <min_linear_acceleration>-1.0</min_linear_acceleration>
      <max_angular_acceleration>2.0</max_angular_acceleration>
      <min_angular_acceleration>-2.0</min_angular_acceleration>
      <max_linear_velocity>1.2</max_linear_velocity>
      <min_linear_velocity>-1.2</min_linear_velocity>
      <max_angular_velocity>1.5</max_angular_velocity>
      <min_angular_velocity>-1.5</min_angular_velocity>
      <publish_odom>false</publish_odom>
      <publish_odom_tf>false</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>
    </plugin>
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <dimensions>2D</dimensions>
      <odom_publish_frequency>30</odom_publish_frequency>
      <odom_topic>/model/wildos_rover/odometry_gt</odom_topic>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher"/>
  </gazebo>
</robot>
